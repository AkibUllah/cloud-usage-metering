# Application
APP_NAME=cloud-usage-metering
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (SQLite for local dev, Postgres in docker compose)
DATABASE_URL=sqlite:///./metering.db
# DATABASE_URL=postgresql+psycopg://metering:metering@db:5432/metering

# Optional shared secret. When set, every /v1/* request must send X-API-Key.
# API_KEY=replace-with-a-long-random-string

# Rating
DEFAULT_CURRENCY=BDT
RATING_GRANULARITY=hour          # hour | day
MAX_BATCH_SIZE=1000
